! Orszag-Tang vortex (Orszag & Tang 1979; Fromang, Teyssier & Hennebelle 2006)
! MHD test, 3D unigrid, for the mini-ramses-dev GPU MHD integrator (cube/"rock"
! kernel). The vortex is a 2D problem in the x-y plane laid out uniform along z
! (z-symmetry); default 256^3 (levelmin=levelmax=8), no AMR. ICs are grafic files
! written by mini-ramses-dev/utils/py/grafic/orszag_tang.py (auto-generated by the
! harness if absent); initfile(1) is rewritten in place by dmo_gpu.slurm from
! ${IC_DIR}.
!
! GPU MHD is PERIODIC-ONLY; the Orszag-Tang vortex is naturally periodic, so
! periodic boundaries are the physical choice here (unlike brio-wu, which is
! reflective on the CPU and only periodic for the GPU comparison). Standard final
! time t=0.5 with outputs at t=0.25 and t=0.5 (delta_tout=0.25); t=0.5 shows the
! developed current sheet and shock structure. For a bit-level CPU comparison run
! the CPU build with THIS same namelist + the same grafic ICs.
!
! Build (handled by submit_profiles.sh orszag-tang / hackathon_build_binary):
!   make COMPILER=NVHPC CUDA_ARCH=sm_80 \
!        COMPILER=NVHPC NHILBERT=1 HYDRO=1 MHD=1 NPSCAL=0 NPRE=4 NDIM=3 ramses
!        (NVAR=5; B lives in bold/bnew, no passive scalars; no GRAV, no UNITS=COSMO)
!
! GPU-MEMORY NOTE: the cube kernel spills corner states to a per-block global
! scratch (~162 KB/oct). 256^3 needs a reduced footprint (Fable memory work) or
! an 80 GB+ A100; use ORSZAG_TANG_LEVEL=7 (128^3) or 6 (64^3) for smaller GPUs.

&RUN_PARAMS
 cosmo=.false.
 hydro=.true.
 poisson=.false.
 pic=.false.
 nrestart=0
 nstepmax=10000
 nsubcycle=10*1,
 ncontrol=1
 nsuperoct=2
 verbose=.false.
 debug=.false.
/

&OUTPUT_PARAMS
 delta_tout=0.25
 tend=0.5
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='ics_orszag_tang'
/

&AMR_PARAMS
 levelmin=7
 levelmax=7
 ngridmax=2500000
 ncachemax=200000
 nexpand=1,
 boxlen=1.0
/

&HYDRO_PARAMS
 gamma=1.6666667
 courant_factor=0.8
 slope_type=2
 slope_mag_type=2
 riemann='hlld'
 riemann2d='hlld'
/

&BOUNDARY_PARAMS
 periodic=.true.,.true.,.true.
/
