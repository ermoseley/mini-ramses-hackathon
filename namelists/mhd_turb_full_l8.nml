! UNITS RESCALED to code units c_s=rho=P=1: 1 pc box (units_length=3.08568d18,
! units_time=5.7815d13, units_density=7.0d-23, eos_T2=34.25993294742506), boxlen=1.
! Mach/beta figures below predate this rescaling (old c_s~0.19) and need re-deriving.
! Full-spec driven MHD turbulence: 256^3 unigrid (level 8), parabolic driving,
! turb_T=0.1, turb_rms=200 (user a_turb), plasma beta=0.1 via uniform Bz (~0.779).
! ICs: hackathon_ensure_mhd_turb_ics 8 with MHD_TURB_BZ=0.7792435587233456
! (beta = 2*p0/Bz^2 for uniform Bz, isothermal p0 from uniform.py defaults).

&RUN_PARAMS
 cosmo=.false.
 hydro=.true.
 poisson=.false.
 pic=.false.
 nrestart=0
 nstepmax=100000
 nsubcycle=10*1,
 ncontrol=1
 nsuperoct=2
 nremap=10
 verbose=.false.
 debug=.false.
/

&OUTPUT_PARAMS
 delta_tout=0.25
 tend=0.5
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='ics_mhd_turb'
/

&AMR_PARAMS
 levelmin=8
 levelmax=8
 ngridmax=2500000
 ncachemax=12000000
 nexpand=1,
 boxlen=1
/

&TURB_PARAMS
 turb=.true.
 turb_seed=1
 comp_frac=0.5
 forcing_power_spectrum='parabolic'
 turb_T=0.1
 turb_Ndt=100
 turb_rms=200.0
 turb_min_rho=2.5470372511355715d-6
/

&HYDRO_PARAMS
 gamma=1.4
 courant_factor=0.8
 slope_type=1
 slope_mag_type=2
 riemann='hlld'
 riemann2d='hlld'
 switch_llf_dmin=1e-5
 smallc=1e-12
 smallr=1e-10
/

&COOLING_PARAMS
 isothermal=.true.
 eos_type=1
 eos_T2=34.25993294742506
 T2max=34.25993294742506
/

&UNITS_PARAMS
 units_density=7.0d-23
 units_time=5.7815d13
 units_length=3.08568d18
/

&BOUNDARY_PARAMS
 periodic=.true.,.true.,.true.
/

&REFINE_PARAMS
 interpol_var=0
 interpol_type=0
 err_grad_p=0.1
/
