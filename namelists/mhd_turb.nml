! Driven MHD turbulence, 3D unigrid, for the mini-ramses-dev GPU turbulent-driving
! port (gpu_turb branch). A uniform box (uniform rho/p, zero velocity) threaded by a
! uniform magnetic field Bz = 4 is stirred by solenoidal+compressive forcing. The
! turbulent acceleration field is generated on the HOST (FFTW) and interpolated /
! applied on the GPU by the three turb_device kernels.
!
! ICs are grafic files written by mini-ramses-dev/utils/py/grafic/uniform.py
! (auto-generated by the harness if absent, with --bz 4 --rho/--p0/--size matching
! the values below); initfile(1) is rewritten in place by dmo_gpu.slurm from
! ${IC_DIR}.
!
! GPU MHD is PERIODIC-ONLY, so this uses periodic boundaries. Default 64^3
! (MHD_TURB_LEVEL=6); raise with care -- the MHD cube kernel scratch is ~162 KB/oct
! (128^3 needs an 80 GB A100).
!
! Build (handled by submit_profiles.sh mhd-turb / hackathon_build_binary):
!   make COMPILER=NVHPC CUDA_ARCH=sm_80 NHILBERT=1 HYDRO=1 MHD=1 TURB=1 \
!        NPSCAL=0 NPRE=4 NDIM=3 ramses
!   (NVAR=5; B lives in bold/bnew; TURB=1 links FFTW for the host field generation.)
!   NOTE: Makefile.a100/.h100 link FFTW under ifeq($(TURB),1); ensure the FFTW path
!   in the Makefile (or FFTW=...) is valid on the build node.

&RUN_PARAMS
 cosmo=.false.
 hydro=.true.
 poisson=.false.
 pic=.false.
 nrestart=0
 nstepmax=100000
 nsubcycle=10*1,
 ncontrol=1
 nsuperoct=2
 nremap=10
 verbose=.false.
 debug=.false.
/

&OUTPUT_PARAMS
 delta_tout=0.25
 tend=0.5
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='ics_mhd_turb'
/

&AMR_PARAMS
 levelmin=6
 levelmax=6
 ngridmax=400000
 ncachemax=200000
 nexpand=1,
 boxlen=4.0
/

&TURB_PARAMS
 turb=.true.
 turb_seed=1
 comp_frac=0.5
 forcing_power_spectrum='power_law'
 turb_T=0.29241000937376255
 turb_Ndt=100
 turb_rms=5.094074502271999
 turb_min_rho=2.5470372511355715d-6
/

&HYDRO_PARAMS
 gamma=1.4
 courant_factor=0.8
 slope_type=1
 slope_mag_type=2
 riemann='hlld'
 riemann2d='hlld'
 switch_llf_dmin=1e-5
 smallc=1e-12
 smallr=1e-10
/

&COOLING_PARAMS
 isothermal=.true.
 eos_type=1
 eos_T2=4.2194
/

&UNITS_PARAMS
 units_density=1.50492957435d-20
 units_time=3.1556926d13
 units_length=3.0857d18
/

&BOUNDARY_PARAMS
 periodic=.true.,.true.,.true.
/

&REFINE_PARAMS
 interpol_var=0
 interpol_type=0
 err_grad_p=0.1
/
