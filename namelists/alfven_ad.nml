! Alfvén wave ambipolar damping: B_y = A_ave sin(kx), v_y = -A_ave sin(kx), B_z = C_ave.
! Theory (linear, rho=1): amplitude ~ exp(-gamma t), gamma = eta_ad * k^2 * C_ave^2 / (2*rho).
! make NDIM=3 MPI=1 HYDRO=1 MHD=1 INIT=ALFVENAD

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=1,2
verbose=.false.
nsuperoct=0
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=80000
nexpand=1
boxlen=1.0
/

&INIT_PARAMS
A_ave=0.01
C_ave=1.0
/

&OUTPUT_PARAMS
delta_tout=0.01
tend=0.05
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.1
slope_type=2
riemann='llf'
riemann2d='llf'
induction=.false.
etamag=0.0
eta_ad=1.0
cp_ad=0.8
/

&REFINE_PARAMS
interpol_var=0
interpol_type=2
/
