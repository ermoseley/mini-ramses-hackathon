! Circularly polarized standing Alfvén wave with ambipolar damping: guide B_x = C_ave (parallel to k),
! B_y = -A_ave/sqrt(2) sin(kx), B_z = +A_ave/sqrt(2) sin(kx), v_y = v_z = -A_ave/sqrt(2) cos(kx) at t=0.
! The transverse field rotates in time so that
! |B_perp| = A_ave |sin(kx)| is a FIXED spatial pattern decaying monotonically as exp(-gamma t).
! gamma = eta_ad * C_ave^2 * k^2 / (2*rho); eta_ad=0.1 => gamma ~ 1.974, omega = k*C_ave/sqrt(rho) ~ 6.283 (~2 periods by tend=2).
! make NDIM=3 MPI=1 HYDRO=1 MHD=1 INIT=ALFVENAD

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=1,2
verbose=.false.
nsuperoct=0
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=80000
nexpand=1
boxlen=1.0
/

&INIT_PARAMS
A_ave=0.01
C_ave=1.0
/

&OUTPUT_PARAMS
delta_tout=0.05
tend=2.0
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=2
riemann='hlld'
riemann2d='hlld'
slope_mag_type=2
induction=.false.
etamag=0.0
eta_ad=0.1
cp_ad=0.8
rkg_alpha=-1
/

&REFINE_PARAMS
interpol_var=0
interpol_type=2
/
