! Standing Alfvén wave with ambipolar damping: guide field B_x = C_ave, B_y = -A_ave sin(kx), v_y = 0.
! Energy sloshes B<->v at omega = k*v_A = 2*pi*C_ave/sqrt(rho) ~ 6.283; |B_y| ~ |cos(omega t)| under an exp(-gamma t) envelope.
! gamma = eta_ad * C_ave^2 * k^2 / (2*rho); eta_ad=0.02 => gamma ~ 0.395 (~2.5 periods per e-fold, ~10 oscillations by tend=10).
! make NDIM=3 MPI=1 HYDRO=1 MHD=1 INIT=ALFVENAD

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=1,2
verbose=.false.
nsuperoct=0
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=80000
nexpand=1
boxlen=1.0
/

&INIT_PARAMS
A_ave=0.01
C_ave=1.0
/

&OUTPUT_PARAMS
delta_tout=0.1
tend=10.0
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=2
riemann='hlld'
riemann2d='hlld'
slope_mag_type=2
induction=.false.
etamag=0.0
eta_ad=0.02
cp_ad=0.8
rkg_alpha=-1
/

&REFINE_PARAMS
interpol_var=0
interpol_type=2
/
