! Sec. 3.3 circularly polarized Alfven wave (Moseley+2023, mu=0): B = v = A_ave cos(kz) x + A_ave sin(kz) y + C_ave z at t=0.
! Traveling CP wave along z; Sec. 3.3 is ideal (no AD). With eta_ad>0, |B_perp| ~ A_ave exp(-gamma t), gamma = eta_ad*C_ave^2*k^2/(2*rho).
! make NDIM=3 MPI=1 HYDRO=1 MHD=1 INIT=ALFVENAD

&RUN_PARAMS
hydro=.true.
ncontrol=1
nsubcycle=1,2
verbose=.false.
nsuperoct=0
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=80000
nexpand=1
boxlen=1.0
/

&INIT_PARAMS
A_ave=0.1
C_ave=1.0
/

&OUTPUT_PARAMS
delta_tout=0.05
tend=2.0
/

&COOLING_PARAMS
isothermal=.true.
eos_type=1
eos_T2=1.21215509888253e-8
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=2
riemann='hlld'
riemann2d='hlld'
slope_mag_type=2
induction=.false.
etamag=0.0
eta_ad=0.1
cp_ad=0.8
rkg_alpha=0.5
/

&REFINE_PARAMS
interpol_var=0
interpol_type=2
/
