! debug-cosmo CPU MPI (96 ranks on full Stellar pu node).
! Same physics as debug_cosmo.nml; per-process caps = GPU totals / 96.
! initfile(1) rewritten by dmo_cpu.slurm from ${IC_DIR}.
! Build: BUILD_CPU=1 HYDRO=1 GRAV=1 UNITS=COSMO NPRE=8 Makefile.cpu

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
/

&OUTPUT_PARAMS
aout=0.5
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ics_ramses'
/

&AMR_PARAMS
levelmin=7
levelmax=15
ngridmax=62500
npartmax=41667
ncachemax=41667
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-4
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
riemann='hllc'
/

&COOLING_PARAMS
isothermal=.true.
eos_type=1
eos_T2=50.
/

&REFINE_PARAMS
m_refine=10*8.,
interpol_var=1
interpol_type=0
/

&STAR_PARAMS
star=.false.
nstarmax=2000000
n_star=0.1
eps_star=0.01
m_star=1
/
