! Orszag-Tang vortex with GPU subgrid-scale (Smagorinsky-Lilly) turbulence model.
! Same 256^3 unigrid setup as orszag_tang.nml but sgs_turb=.true. and NPSCAL=1
! (NVAR=6; iturb=6 holds rho*e_turb). Requires gpu_sgs branch + gpu_sgs.cuf build.
!
! Build (submit_profiles.sh ot-sgs):
!   make COMPILER=NVHPC CUDA_ARCH=sm_80 \
!        NHILBERT=1 HYDRO=1 MHD=1 NPSCAL=1 NPRE=4 NDIM=3 ramses
!
! GPU-MEMORY: 256^3 cube MHD + SGS passive scalar; prefer 80G A100 (ORSZAG_TANG_LEVEL=7
! for 128^3 smoke on 40G).

&RUN_PARAMS
 cosmo=.false.
 hydro=.true.
 poisson=.false.
 pic=.false.
 nrestart=0
 nstepmax=10000
 nsubcycle=10*1,
 ncontrol=1
 nsuperoct=2
 verbose=.false.
 debug=.false.
/

&OUTPUT_PARAMS
 delta_tout=0.25
 tend=0.5
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='ics_orszag_tang'
/

&AMR_PARAMS
 levelmin=8
 levelmax=8
 ngridmax=2500000
 ncachemax=200000
 nexpand=1,
 boxlen=1.0
/

&HYDRO_PARAMS
 gamma=1.6666667
 courant_factor=0.8
 slope_type=2
 slope_mag_type=2
 riemann='hlld'
 riemann2d='hlld'
 sgs_turb=.true.
/

&BOUNDARY_PARAMS
 periodic=.true.,.true.,.true.
/
