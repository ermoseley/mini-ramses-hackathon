! Same as dmo.nml but disables the GPU CIC warp-coalesce fast path
! (gpu_cic_fast_path=.false.) for A/B testing against dmo-cpu.
!
! initfile(1) is rewritten by dmo_gpu.slurm from ${IC_DIR}.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.false.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
gpu_cic_fast_path=.false.
/

&OUTPUT_PARAMS
delta_aout=0.1
aend=1.0
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ics_ramses'
/

&AMR_PARAMS
levelmin=7
levelmax=15
ngridmax=4000000
ncachemax=2000000
npartmax=4000000
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-4
part_dep_algo=2
/

&REFINE_PARAMS
m_refine=10*8.,
/
