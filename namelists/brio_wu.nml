! Brio & Wu (1988) MHD shock tube, 3D unigrid, for the mini-ramses-dev GPU MHD
! integrator (cube/"rock" kernel). The 1D shock runs along x and is uniform in
! y,z; default 128^3 (levelmin=levelmax=7), no AMR. ICs are grafic files written
! by mini-ramses-dev/utils/py/grafic/brio_wu.py (auto-generated by the harness if
! absent); initfile(1) is rewritten in place by dmo_gpu.slurm from ${IC_DIR}.
!
! GPU MHD is PERIODIC-ONLY, so this uses periodic boundaries (unlike the reflective
! CPU reference namelist/brio_wu.nml). Run to t=0.1 (one output): at that time the
! central structure is clean; for a bit-level CPU comparison run the CPU build with
! THIS same periodic namelist + the same grafic ICs.
!
! Build (handled by submit_profiles.sh brio-wu / hackathon_build_binary):
!   make COMPILER=NVHPC CUDA_ARCH=sm_80 \
!        COMPILER=NVHPC NHILBERT=1 HYDRO=1 MHD=1 NPSCAL=0 NPRE=4 NDIM=3 ramses
!        (NVAR=5; B lives in bold/bnew, no passive scalars; no GRAV, no UNITS=COSMO)
!
! GPU-MEMORY NOTE: the cube kernel spills its 4 edge corner states to a global
! scratch sized per launched block (~162 KB/oct). At 128^3 that is ~44 GB, so the
! 128^3 case needs an 80 GB A100; use BRIO_WU_LEVEL=6 (64^3, ~6 GB) on a 40 GB
! A100. The lazy allocation has a stat= OOM guard (clean error stop) if the GPU
! is too small.

&RUN_PARAMS
 cosmo=.false.
 hydro=.true.
 poisson=.false.
 pic=.false.
 nrestart=0
 nstepmax=1000
 nsubcycle=10*1,
 ncontrol=1
 nsuperoct=2
 verbose=.false.
 debug=.false.
/

&OUTPUT_PARAMS
 tend=0.1
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='ics_brio_wu'
/

&AMR_PARAMS
 levelmin=7
 levelmax=7
 ngridmax=400000
 ncachemax=200000
 nexpand=1,
 boxlen=1.0
/

&HYDRO_PARAMS
 gamma=2.0
 courant_factor=0.8
 slope_type=2
 slope_mag_type=2
 riemann='hlld'
 riemann2d='hlld'
/

&BOUNDARY_PARAMS
 periodic=.true.,.true.,.true.
/
