! Cosmological DM + gas run (mini-ramses-dev/namelist/cosmo.nml adapted for
! mini-ramses-dev/gpu). Isothermal gas only — no cooling, metals, or star
! formation. initfile(1) is rewritten by dmo_cpu.slurm / dmo_gpu.slurm from
! ${IC_DIR}.
!
! Grafic ICs: ic_deltab, ic_velcx/y/z, ic_tempb (+ DM ic_pos/ic_vel in ics_ramses).
! Compile the GPU binary with HYDRO=1, e.g.:
!   make CUDA_ARCH=sm_80 NPRE=4 COMPILER=NVHPC NHILBERT=1 GRAV=1 HYDRO=1 NDIM=3 UNITS=COSMO ramses

&RUN_PARAMS
 cosmo=.true.
 pic=.true.
 poisson=.true.
 hydro=.true.
 nrestart=0
 nstepmax=1000
 nsubcycle=1,1,2
 ncontrol=1
 nremap=10
 verbose=.false.
 debug=.false.
 nsuperoct=2
/

&OUTPUT_PARAMS
 delta_aout=0.1
 aend=1.0
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='__ABSOLUTE_IC_DIR_SET_BY_SLURM__'
/

&AMR_PARAMS
 levelmin=7
 levelmax=15
 ngridmax=4000000
 ncachemax=2000000
 npartmax=4000000
 nexpand=1
 boxlen=1.0
/

&POISSON_PARAMS
 epsilon=1.d-4
 part_mass_deposition_scheme=1
 part_dep_algo=2
 part_force_interpolation_scheme=1
/

&HYDRO_PARAMS
 gamma=1.6666667
 courant_factor=0.8
 slope_type=1
 riemann='hll'
/

&COOLING_PARAMS
 ! Match RAMSES no-cooling grafic init (input_hydro_grafic.f90):
 !   T2_start = 1.356d-2/aexp**2  (K, T/mu)
 ! ics_ramses grafic header: aexp = 0.019607843831181526 (z = 50).
 isothermal=.true.
 eos_type=1
 eos_T2=35.269558d0
/

&REFINE_PARAMS
 m_refine=10*8.,
 interpol_var=1
 interpol_type=0
/

&UNITS_PARAMS
 units_density=1.0d0
 units_length=1.0d0
 units_time=1.0d0
/

&BOUNDARY_PARAMS
 periodic=.true.,.true.,.true.
/
