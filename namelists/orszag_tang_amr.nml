! Orszag-Tang vortex (Orszag & Tang 1979; Fromang, Teyssier & Hennebelle 2006)
! MHD test with AMR for mini-ramses-dev (GPU cube kernel or CPU MPI reference).
! Same physics as orszag_tang.nml: 2D (x,y) vortex uniform along z (z-symmetry),
! periodic boundaries, standard final time t=0.5 with outputs at t=0.25 and
! t=0.5 (delta_tout=0.25). Base grid 32^3 (levelmin=5); refinement to levelmax=8
! via pressure-gradient criterion (err_grad_p=0.15).
! ICs are grafic files from mini-ramses-dev/utils/py/grafic/orszag_tang.py at
! levelmin (auto-generated by the harness if absent); initfile(1) is rewritten
! in place by dmo_gpu.slurm / dmo_cpu.slurm (ic_grafic symlink in workdir).
!
! GPU build (submit_profiles.sh ot-amr):
!   make COMPILER=NVHPC NHILBERT=1 HYDRO=1 MHD=1 NPSCAL=0 NPRE=8 NDIM=3 ramses
! CPU build (submit_profiles.sh ot-cpu):
!   make -f Makefile.cpu COMPILER=GNU MPI=1 NHILBERT=1 HYDRO=1 MHD=1 NPSCAL=0
!        NPRE=8 NDIM=3 ramses  -> ramses3d.mhd.cpu
!        (NVAR=5; B in bold/bnew; no passive scalars; no GRAV, no UNITS=COSMO)

&RUN_PARAMS
 cosmo=.false.
 hydro=.true.
 poisson=.false.
 pic=.false.
 nrestart=0
 nstepmax=100000
 nsubcycle=10*1,
 ncontrol=1
 nsuperoct=2
 verbose=.false.
 debug=.false.
/

&OUTPUT_PARAMS
 delta_tout=0.25
 tend=0.5
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='ic_grafic'
/

&AMR_PARAMS
 levelmin=5
 levelmax=8
 ngridmax=30000000
 ncachemax=12000000
 nexpand=1,
 boxlen=1.0
/

&HYDRO_PARAMS
 gamma=1.6666667
 courant_factor=0.8
 slope_type=2
 slope_mag_type=2
 riemann='hlld'
 riemann2d='hlld'
/

&REFINE_PARAMS
 err_grad_p=0.15
 interpol_var=0
 interpol_type=2
/

&BOUNDARY_PARAMS
 periodic=.true.,.true.,.true.
/
