! 128^3 unigrid (level 7), Mach~10 (turb_rms=36.370084, turb_T=0.1, beta=0.1).
! Marlowe interactive smoke before 512^3 batch; HLLD.
! Mach ~ C*sqrt(turb_rms), C~1.658 from Stellar L8 a200 (turb_rms=200 -> M~23.45).
! ICs: hackathon_ensure_mhd_turb_ics 7 with MHD_TURB_BZ=0.7792435587233456

&RUN_PARAMS
 cosmo=.false.
 hydro=.true.
 poisson=.false.
 pic=.false.
 nrestart=0
 nstepmax=100000
 nsubcycle=10*1,
 ncontrol=1
 nsuperoct=2
 nremap=10
 verbose=.false.
 debug=.false.
/

&OUTPUT_PARAMS
 ! delta_tout must be <= tend or int(tend/delta_tout)=0 -> noutput=0 -> 1-step exit
 delta_tout=0.05
 tend=0.05
/

&INIT_PARAMS
 filetype='grafic'
 initfile(1)='ics_mhd_turb'
/

&AMR_PARAMS
 levelmin=7
 levelmax=7
 ngridmax=800000
 ncachemax=3000000
 nexpand=1,
 boxlen=4.0
/

&TURB_PARAMS
 turb=.true.
 turb_seed=1
 comp_frac=0.5
 forcing_power_spectrum='parabolic'
 turb_T=0.1
 turb_Ndt=100
 turb_rms=36.370084
 turb_min_rho=2.5470372511355715d-6
/

&HYDRO_PARAMS
 gamma=1.4
 courant_factor=0.8
 slope_type=1
 slope_mag_type=2
 riemann='hlld'
 riemann2d='hlld'
 switch_llf_dmin=1e-5
 smallc=1e-12
 smallr=1e-10
/

&COOLING_PARAMS
 isothermal=.true.
 eos_type=1
 eos_T2=4.2194
/

&UNITS_PARAMS
 units_density=1.50492957435d-20
 units_time=3.1556926d13
 units_length=3.0857d18
/

&BOUNDARY_PARAMS
 periodic=.true.,.true.,.true.
/

&REFINE_PARAMS
 interpol_var=0
 interpol_type=0
 err_grad_p=0.1
/
