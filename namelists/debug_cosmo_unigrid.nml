! debug-cosmo unigrid (levelmin=levelmax=7) for GPU/CPU parity checks.
! GPU single-rank totals (rteyssie caps). Use debug_cosmo_unigrid_cpu.nml for
! 96-rank MPI (per-process caps = totals / 96).
! initfile(1) rewritten by dmo_* slurm from ${IC_DIR}.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
/

&OUTPUT_PARAMS
aout=0.5
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='ics_ramses'
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=6000000
npartmax=4000000
ncachemax=4000000
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-4
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
riemann='hllc'
/

&COOLING_PARAMS
isothermal=.true.
eos_type=1
eos_T2=50.
/

&REFINE_PARAMS
m_refine=10*8.,
interpol_var=1
interpol_type=0
/

&STAR_PARAMS
star=.false.
nstarmax=2000000
n_star=0.1
eps_star=0.01
m_star=1
/
