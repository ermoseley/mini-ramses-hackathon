! debug-cosmo: rteyssie develop cosmological DM+gas (isothermal, star off).
! Grafic ICs on Stellar scratch (ic_deltab + ic_velcx/y/z). dmo_gpu.slurm rewrites
! initfile(1) to short symlink ic_grafic when IC_DIR is set; absolute path below is
! the canonical IC root for manual runs and when DMO_NO_DEFAULT_CAPS=1.
! Build: ~/hackathon/Makefile.debug-cosmo (NPRE=8), not repo bin/Makefile.

&RUN_PARAMS
cosmo=.true.
pic=.true.
poisson=.true.
hydro=.true.
nrestart=0
nsubcycle=1,1,2
ncontrol=1
verbose=.false.
/

&OUTPUT_PARAMS
aout=0.5
/

&INIT_PARAMS
filetype='grafic'
initfile(1)='/scratch/gpfs/moseley/hackathon/ics_ramses'
/

&AMR_PARAMS
levelmin=7
levelmax=15
ngridmax=3000000
npartmax=4000000
ncachemax=2000000
nexpand=1,
/

&POISSON_PARAMS
epsilon=1.d-4
/

&HYDRO_PARAMS
gamma=1.6666667
courant_factor=0.8
slope_type=1
riemann='hllc'
/

&COOLING_PARAMS
isothermal=.true.
eos_type=1
eos_T2=50.
/

&REFINE_PARAMS
m_refine=10*8.,
interpol_var=1
interpol_type=0
/

&STAR_PARAMS
star=.false.
nstarmax=2000000
n_star=0.1
eps_star=0.01
m_star=1
/
